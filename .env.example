# Copy to .env and fill in your API key. That's all you need to start.

# --- Primary: the default for everything. Cheap and fast: Claude Haiku ---
LLM_PRIMARY_KIND=anthropic
LLM_PRIMARY_URL=https://api.anthropic.com
LLM_PRIMARY_MODEL=claude-haiku-5-5
LLM_PRIMARY_KEY=
LLM_PRIMARY_VISION=true

# --- Optional separate model for "quick" work (story picking, image focus). Empty = primary. ---
LLM_QUICK_KIND=anthropic
LLM_QUICK_URL=
LLM_QUICK_MODEL=
LLM_QUICK_KEY=
LLM_QUICK_VISION=true

# --- Optional fallback, used only if the primary call fails ---
# Any OpenAI-compatible API: OmniRoute, OpenRouter, local Ollama (http://host.docker.internal:11434/v1) ...
LLM_FALLBACK_KIND=openai
LLM_FALLBACK_URL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_KEY=
LLM_FALLBACK_VISION=false

# --- Better model, only when picked in the header dropdown (never automatic): Claude Sonnet ---
LLM_PAID_KIND=anthropic
LLM_PAID_URL=https://api.anthropic.com
LLM_PAID_MODEL=claude-sonnet-5-5
LLM_PAID_KEY=
LLM_PAID_VISION=true

# --- Daily stories (RSS + the models above) ---
# After picking, the posts for each story are written in the background (primary model),
# so Jack it! opens a ready draft. Set PREGEN_DRAFTS=false to turn this off.
PREGEN_DRAFTS=true
PREGEN_PLATFORMS=facebook,instagram,linkedin
NEWS_TIME=06:39
NEWS_MAX_AGE_HOURS=72
TZ=Europe/London
LLM_TIMEOUT_MS=240000

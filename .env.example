# Copy to .env and fill in your API key. That's all you need to start.

# --- Primary: Anthropic API ---
LLM_PRIMARY_KIND=anthropic
LLM_PRIMARY_URL=https://api.anthropic.com
LLM_PRIMARY_MODEL=claude-sonnet-5-5
LLM_PRIMARY_KEY=
LLM_PRIMARY_VISION=true

# --- Optional fallback, used only if the primary call fails ---
# Any OpenAI-compatible API: OmniRoute, OpenRouter, local Ollama (http://host.docker.internal:11434/v1) ...
LLM_FALLBACK_KIND=openai
LLM_FALLBACK_URL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_KEY=
LLM_FALLBACK_VISION=false

# --- Optional second model, only when picked in the app's header dropdown ---
LLM_PAID_KIND=anthropic
LLM_PAID_URL=
LLM_PAID_MODEL=
LLM_PAID_KEY=
LLM_PAID_VISION=true

# --- Daily stories (RSS + the model above) ---
NEWS_TIME=06:39
NEWS_MAX_AGE_HOURS=72
TZ=Europe/London
LLM_TIMEOUT_MS=240000
